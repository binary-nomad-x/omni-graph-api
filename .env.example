# ==========================================
# Application
# ==========================================
APPLICATION_NAME="OmniGraph API"
NODE_ENV=development
PORT=4000

# ==========================================
# PostgreSQL Database
# ==========================================
DB_CONNECTION=pgsql
DB_HOST=localhost
DB_PORT=5433
DB_DATABASE=graphql_api
DB_USERNAME=postgres
DB_PASSWORD=
DB_SCHEMA=public

# PostgreSQL connection URL
DATABASE_URL="postgresql://USERNAME:PASSWORD@HOST:PORT/DATABASE?schema=public"

# ==========================================
# Default User
# ==========================================
DEFAULT_USER_PASSWORD=change_me

# ==========================================
# Novu Notifications
# ==========================================
NOVU_API_HOST_NAME=https://api.novu.co
NOVU_API_WEB_SOCKET_HOST_NAME=wss://socket.novu.co
NOVU_API_SECRET_KEY=your_novu_api_secret_key

# ==========================================
# Redis
# ==========================================
REDIS_URL=redis://localhost:6379

# ==========================================
# Weather API
# ==========================================
WEATHER_API_BASE_URL=https://api.open-meteo.com/v1/forecast