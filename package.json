{
  "name": "omni-graph-api",
  "version": "1.0.0",
  "main": "src/index.ts",
  "type": "module",
  "prisma": {
    "seed": "tsx prisma/seed/index.ts"
  },
  "scripts": {
    "dev": "tsx src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "migrate:dev": "npx prisma migrate dev",
    "studio": "npx prisma studio",
    "generate": "npx prisma generate",
    "db:push": "npx prisma db push",
    "db:reset": "npx prisma migrate reset",
    "seed": "tsx prisma/seed/index.ts",
    "seed:reset": "tsx prisma/seed/index.ts --reset",
    "seed:fresh": "tsx prisma/seed/index.ts --fresh",
    "db:rebuild": "npx prisma generate && npx prisma db push --force-reset && npm run seed && npm run schema:merge",
    "schema:merge": "tsx scripts/misc/merge-schema.ts",
    "novu": "tsx scripts/novu-sync/cli.ts",
    "novu:list": "tsx scripts/novu-sync/cli.ts list",
    "novu:status": "tsx scripts/novu-sync/cli.ts status",
    "novu:diff": "tsx scripts/novu-sync/cli.ts diff",
    "novu:pull": "tsx scripts/novu-sync/cli.ts pull",
    "novu:pull:one": "tsx scripts/novu-sync/cli.ts pull --only=",
    "novu:push": "tsx scripts/novu-sync/cli.ts push",
    "novu:push:one": "tsx scripts/novu-sync/cli.ts push --only=",
    "novu:push:force": "tsx scripts/novu-sync/cli.ts push --force",
    "novu:create:workflow": "tsx scripts/novu-sync/cli.ts create-workflow",
    "novu:create:layout": "tsx scripts/novu-sync/cli.ts create-layout",
    "novu:delete:workflow": "tsx scripts/novu-sync/cli.ts delete-workflow",
    "novu:delete:layout": "tsx scripts/novu-sync/cli.ts delete-layout",
    "novu:help": "tsx scripts/novu-sync/cli.ts help",
    "setup": "npm install && npx prisma generate && npx prisma migrate dev && npm run seed",
    "format": "prettier --write \"**/*.{ts,tsx}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx}\""
  },
  "dependencies": {
    "@apollo/server": "^5.5.1",
    "@faker-js/faker": "^10.4.0",
    "@novu/node": "^2.6.6",
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.7.0",
    "bcryptjs": "^2.4.3",
    "bullmq": "^5.80.2",
    "cors": "^2.8.6",
    "dotenv": "^16.4.7",
    "express": "^4.22.2",
    "graphql": "^16.13.2",
    "ioredis": "^5.11.1",
    "jsonwebtoken": "^9.0.3",
    "node-cron": "^4.6.0",
    "pg": "^8.20.0",
    "prom-client": "^15.1.3"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/body-parser": "^1.19.6",
    "@types/cors": "^2.8.19",
    "@types/ioredis": "^4.28.10",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^22.10.0",
    "@types/pg": "^8.20.0",
    "prettier": "^3.9.5",
    "prisma": "^7.7.0",
    "ts-node": "^10.9.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.0"
  }
}
