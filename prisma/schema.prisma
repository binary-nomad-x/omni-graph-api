generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ==================== User Model ====================
model User {
  id          String   @id @default(cuid())
  email       String   @unique
  username    String   @unique
  name        String?
  age         Int      @default(0)
  password    String
  role        String   @default("USER")
  avatarUrl   String?
  bio         String?
  phone       String?
  isVerified  Boolean  @default(false)
  lastLoginAt DateTime @default(now())
  locale      String   @default("en-US")
  timezone    String   @default("UTC")
  metadata    Json     @default("{}")

  profile           Profile?
  posts             Post[]
  comments          Comment[]
  likes             Like[]
  products          Product[]
  orders            Order[]
  reviews           Review[]
  postViews         PostView[]
  addresses         Address[]
  wishlists         Wishlist[]
  cart              Cart?
  notifications     Notification[]            @relation("UserNotifications")
  sentNotifications Notification[]            @relation("SentNotifications")
  followers         Follow[]                  @relation("FollowingRelation")
  following         Follow[]                  @relation("FollowerRelation")
  savedPosts        SavedPost[]
  subscriptions     Subscription[]
  conversations     ConversationParticipant[]
  sentMessages      Message[]
  returnRequests    ReturnRequest[]
  ticketReplies     TicketReply[]

  createdTickets   SupportTicket[] @relation("CreatedTickets")
  assignedTickets  SupportTicket[] @relation("AssignedTickets")
  escalatedTickets SupportTicket[] @relation("EscalatedTickets")

  followedCategories UserCategoryFollow[]
  couponCreations    Coupon[]             @relation("CouponCreator")
  discountCreations  Discount[]           @relation("DiscountCreator")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([email])
  @@index([username])
  @@index([role])
  @@map("users")
}

// ==================== UserCategoryFollow (new junction) ====================
model UserCategoryFollow {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  categoryId  String
  category    Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  notifyOnNew Boolean  @default(true)
  followedAt  DateTime @default(now())

  @@unique([userId, categoryId])
  @@map("user_category_follows")
}

// ==================== Profile Model ====================
model Profile {
  id             String   @id @default(cuid())
  bio            String?
  avatar         String?
  phone          String?
  address        String?
  fullName       String?
  dateOfBirth    DateTime @default(now())
  gender         String?
  occupation     String?
  company        String?
  website        String?
  education      String?
  newsletter     Boolean  @default(true)
  marketingOptIn Boolean  @default(true)

  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("profiles")
}

// ==================== Address Model ====================
model Address {
  id                   String   @id @default(cuid())
  userId               String
  user                 User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  label                String   @default("Home")
  street               String
  addressLine2         String?
  city                 String
  state                String?
  zip                  String
  country              String   @default("US")
  phone                String?
  deliveryInstructions String?
  latitude             Float    @default(0)
  longitude            Float    @default(0)
  isDefault            Boolean  @default(false)
  isBilling            Boolean  @default(false)
  contactName          String?
  contactPhone         String?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  @@unique([userId, label])
  @@index([userId])
  @@map("addresses")
}

// ==================== Post Model ====================
model Post {
  id              String      @id @default(cuid())
  title           String
  slug            String      @unique
  content         String?
  excerpt         String?
  coverImage      String?
  readingTime     Int         @default(1)
  published       Boolean     @default(false)
  isFeatured      Boolean     @default(false)
  isArchived      Boolean     @default(false)
  metaTitle       String?
  metaDescription String?
  allowComments   Boolean     @default(true)
  viewCount       Int         @default(0)
  likeCount       Int         @default(0)
  commentCount    Int         @default(0)
  authorId        String
  author          User        @relation(fields: [authorId], references: [id], onDelete: Cascade)
  tags            Tag[]       @relation("PostToTag")
  categories      Category[]  @relation("PostToCategory")
  comments        Comment[]
  likes           Like[]
  savedBy         SavedPost[]
  views           PostView[]
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  @@index([authorId])
  @@index([published])
  @@index([slug])
  @@map("posts")
}

// ==================== SavedPost Model ====================
model SavedPost {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  postId    String
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  note      String?
  folder    String   @default("Default")
  createdAt DateTime @default(now())

  @@unique([userId, postId])
  @@map("saved_posts")
}

// ==================== PostView Model ====================
model PostView {
  id        String   @id @default(cuid())
  postId    String
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  ip        String?
  referrer  String?
  userAgent String?
  country   String?
  city      String?
  device    String?
  browser   String?
  duration  Int      @default(0)
  viewedAt  DateTime @default(now())

  @@index([postId])
  @@map("post_views")
}

// ==================== Tag Model ====================
model Tag {
  id          String   @id @default(cuid())
  name        String   @unique
  slug        String   @unique
  description String?
  color       String   @default("#6366f1")
  icon        String?
  isFeatured  Boolean  @default(false)
  posts       Post[]   @relation("PostToTag")
  createdAt   DateTime @default(now())

  @@map("tags")
}

// ==================== Category Model ====================
model Category {
  id           String  @id @default(cuid())
  name         String  @unique
  slug         String  @unique
  description  String?
  icon         String?
  imageUrl     String?
  displayOrder Int     @default(0)
  isFeatured   Boolean @default(false)

  parentId String?
  parent   Category?  @relation("CategoryHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  children Category[] @relation("CategoryHierarchy")

  posts       Post[]               @relation("PostToCategory")
  products    Product[]
  userFollows UserCategoryFollow[]
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt

  @@index([parentId])
  @@map("categories")
}

// ==================== Comment Model ====================
model Comment {
  id         String    @id @default(cuid())
  content    String
  isEdited   Boolean   @default(false)
  isApproved Boolean   @default(true)
  upvotes    Int       @default(0)
  downvotes  Int       @default(0)
  authorId   String
  author     User      @relation(fields: [authorId], references: [id], onDelete: Cascade)
  postId     String
  post       Post      @relation(fields: [postId], references: [id], onDelete: Cascade)
  parentId   String?
  parent     Comment?  @relation("CommentReplies", fields: [parentId], references: [id], onDelete: SetNull)
  replies    Comment[] @relation("CommentReplies")
  editedAt   DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@index([authorId])
  @@index([postId])
  @@index([parentId])
  @@map("comments")
}

// ==================== Like Model ====================
model Like {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  postId    String
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  type      String   @default("LIKE")
  createdAt DateTime @default(now())

  @@unique([userId, postId])
  @@map("likes")
}

// ==================== Follow Model ====================
model Follow {
  id            String   @id @default(cuid())
  followerId    String
  follower      User     @relation("FollowerRelation", fields: [followerId], references: [id], onDelete: Cascade)
  followingId   String
  following     User     @relation("FollowingRelation", fields: [followingId], references: [id], onDelete: Cascade)
  isMutual      Boolean  @default(false)
  notifyOnPost  Boolean  @default(true)
  notifyOnStory Boolean  @default(true)
  createdAt     DateTime @default(now())

  @@unique([followerId, followingId])
  @@index([followerId])
  @@index([followingId])
  @@map("follows")
}

// ==================== Product Model ====================
model Product {
  id              String         @id @default(cuid())
  name            String
  description     String?
  price           Float
  stock           Int            @default(0)
  sku             String         @unique
  barcode         String?
  brand           String?
  color           String?
  weight          Float          @default(0)
  dimensions      String?
  rating          Float          @default(0)
  reviewCount     Int            @default(0)
  soldCount       Int            @default(0)
  minimumStock    Int            @default(0)
  allowBackorder  Boolean        @default(false)
  warrantyInfo    String?
  returnPolicy    String?
  taxClass        String         @default("standard")
  metaTitle       String?
  metaDescription String?
  attributes      Json           @default("{}")
  imageUrl        String?
  images          ProductImage[]
  isActive        Boolean        @default(true)
  sellerId        String
  seller          User           @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  categoryId      String?
  category        Category?      @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  orderItems      OrderItem[]
  reviews         Review[]
  wishlistItems   WishlistItem[]
  cartItems       CartItem[]
  discounts       Discount[]
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  @@index([sellerId])
  @@index([categoryId])
  @@index([sku])
  @@index([brand])
  @@map("products")
}

// ==================== ProductImage Model ====================
model ProductImage {
  id        String   @id @default(cuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  url       String
  alt       String?
  isPrimary Boolean  @default(false)
  width     Int      @default(0)
  height    Int      @default(0)
  fileSize  Int      @default(0)
  mimeType  String   @default("image/jpeg")
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  @@index([productId])
  @@map("product_images")
}

// ==================== Order Model ====================
model Order {
  id                String      @id @default(cuid())
  userId            String
  user              User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  status            String      @default("PENDING")
  totalAmount       Float       @default(0)
  subtotal          Float       @default(0)
  taxAmount         Float       @default(0)
  shippingAmount    Float       @default(0)
  discountAmount    Float       @default(0)
  currency          String      @default("USD")
  shippingAddress   String?
  email             String?
  phone             String?
  notes             String?
  source            String      @default("web")
  isGift            Boolean     @default(false)
  giftMessage       String?
  trackingUrl       String?
  estimatedDelivery DateTime?
  deliveredAt       DateTime?
  cancelledAt       DateTime?
  cancelReason      String?
  couponId          String?
  coupon            Coupon?     @relation(fields: [couponId], references: [id], onDelete: SetNull)
  items             OrderItem[]
  payment           Payment?
  refunds           Refund[]
  shipments         Shipment[]
  invoice           Invoice?
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt

  @@index([userId])
  @@index([status])
  @@map("orders")
}

// ==================== OrderItem Model ====================
model OrderItem {
  id             String          @id @default(cuid())
  orderId        String
  order          Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId      String
  product        Product         @relation(fields: [productId], references: [id], onDelete: Restrict)
  quantity       Int             @default(1)
  unitPrice      Float
  productName    String?
  productSku     String?
  productImage   String?
  discountAmount Float           @default(0)
  taxAmount      Float           @default(0)
  totalPrice     Float           @default(0)
  returnRequests ReturnRequest[]

  @@index([orderId])
  @@index([productId])
  @@map("order_items")
}

// ==================== Payment Model ====================
model Payment {
  id                   String   @id @default(cuid())
  orderId              String   @unique
  order                Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  amount               Float
  currency             String   @default("USD")
  method               String
  gateway              String   @default("stripe")
  gatewayTransactionId String?
  status               String   @default("PENDING")
  fee                  Float    @default(0)
  netAmount            Float    @default(0)
  payerEmail           String?
  payerName            String?
  billingAddress       String?
  failureReason        String?
  refundedAmount       Float    @default(0)
  capturedAmount       Float    @default(0)
  transactionId        String   @unique
  refunds              Refund[]
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  @@map("payments")
}

// ==================== Refund Model ====================
model Refund {
  id                String   @id @default(cuid())
  paymentId         String
  payment           Payment  @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  orderId           String
  order             Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  amount            Float
  currency          String   @default("USD")
  reason            String?
  reasonDescription String?
  status            String   @default("PENDING")
  initiatedBy       String   @default("system")
  fee               Float    @default(0)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([paymentId])
  @@index([orderId])
  @@map("refunds")
}

// ==================== Review Model ====================
model Review {
  id                 String    @id @default(cuid())
  rating             Int
  title              String?
  content            String?
  isVerified         Boolean   @default(false)
  isRecommended      Boolean   @default(true)
  helpfulCount       Int       @default(0)
  unhelpfulCount     Int       @default(0)
  pros               Json      @default("[]")
  cons               Json      @default("[]")
  images             Json      @default("[]")
  responseFromSeller String?
  responseDate       DateTime?
  productId          String
  product            Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  userId             String
  user               User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  @@unique([productId, userId])
  @@index([productId])
  @@index([userId])
  @@index([rating])
  @@map("reviews")
}

// ==================== Wishlist Model ====================
model Wishlist {
  id          String         @id @default(cuid())
  userId      String
  user        User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  name        String         @default("Default")
  description String?
  isPublic    Boolean        @default(false)
  isDefault   Boolean        @default(true)
  itemCount   Int            @default(0)
  shareCode   String?
  items       WishlistItem[]
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  @@index([userId])
  @@map("wishlists")
}

// ==================== WishlistItem Model ====================
model WishlistItem {
  id              String   @id @default(cuid())
  wishlistId      String
  wishlist        Wishlist @relation(fields: [wishlistId], references: [id], onDelete: Cascade)
  productId       String
  product         Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  quantity        Int      @default(1)
  priority        String   @default("MEDIUM")
  priceAtAddition Float    @default(0)
  note            String?
  createdAt       DateTime @default(now())

  @@unique([wishlistId, productId])
  @@map("wishlist_items")
}

// ==================== Cart Model ====================
model Cart {
  id             String     @id @default(cuid())
  userId         String     @unique
  user           User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  notes          String?
  subtotal       Float      @default(0)
  total          Float      @default(0)
  currency       String     @default("USD")
  couponCode     String?
  discountAmount Float      @default(0)
  sessionId      String?
  expiresAt      DateTime?
  items          CartItem[]
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  @@map("carts")
}

// ==================== CartItem Model ====================
model CartItem {
  id              String   @id @default(cuid())
  cartId          String
  cart            Cart     @relation(fields: [cartId], references: [id], onDelete: Cascade)
  productId       String
  product         Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  quantity        Int      @default(1)
  unitPrice       Float    @default(0)
  discountAmount  Float    @default(0)
  totalPrice      Float    @default(0)
  notes           String?
  isSavedForLater Boolean  @default(false)
  createdAt       DateTime @default(now())

  @@unique([cartId, productId])
  @@map("cart_items")
}

// ==================== Coupon Model ====================
model Coupon {
  id                String    @id @default(cuid())
  code              String    @unique
  name              String?
  description       String?
  type              String    @default("PERCENTAGE")
  discountPercent   Float     @default(0)
  discountAmount    Float     @default(0)
  minPurchase       Float     @default(0)
  minQuantity       Int       @default(0)
  maxDiscountAmount Float     @default(0)
  maxUses           Int       @default(0)
  usedCount         Int       @default(0)
  usageLimit        Int       @default(0)
  usageLimitPerUser Int       @default(0)
  isActive          Boolean   @default(true)
  firstOrderOnly    Boolean   @default(false)
  startedAt         DateTime  @default(now())
  expiresAt         DateTime?
  createdById       String?
  createdBy         User?     @relation("CouponCreator", fields: [createdById], references: [id], onDelete: SetNull)
  orders            Order[]
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@index([code])
  @@map("coupons")
}

// ==================== Shipment Model ====================
model Shipment {
  id                 String    @id @default(cuid())
  orderId            String
  order              Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  carrier            String
  trackingNumber     String
  status             String    @default("PENDING")
  shippingMethod     String    @default("standard")
  originAddress      String?
  destinationAddress String?
  weight             Float     @default(0)
  length             Float     @default(0)
  width              Float     @default(0)
  height             Float     @default(0)
  cost               Float     @default(0)
  currency           String    @default("USD")
  notes              String?
  estimatedDelivery  DateTime?
  deliveredAt        DateTime?
  shippedAt          DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  @@index([orderId])
  @@index([trackingNumber])
  @@map("shipments")
}

// ==================== Notification Model ====================
model Notification {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation("UserNotifications", fields: [userId], references: [id], onDelete: Cascade)
  senderId    String?
  sender      User?     @relation("SentNotifications", fields: [senderId], references: [id], onDelete: SetNull)
  type        String
  title       String
  message     String?
  link        String?
  actionUrl   String?
  imageUrl    String?
  channel     String    @default("in-app")
  category    String    @default("general")
  isRead      Boolean   @default(false)
  readAt      DateTime?
  seenAt      DateTime?
  deliveredAt DateTime?
  expiresAt   DateTime?
  metadata    Json      @default("{}")
  createdAt   DateTime  @default(now())

  @@index([userId])
  @@index([userId, isRead])
  @@map("notifications")
}

// ==================== Subscription Model ====================
model Subscription {
  id                 String    @id @default(cuid())
  userId             String
  user               User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan               String
  status             String    @default("ACTIVE")
  startDate          DateTime
  endDate            DateTime?
  trialStartDate     DateTime?
  trialEndDate       DateTime?
  autoRenew          Boolean   @default(true)
  billingCycle       String    @default("monthly")
  paymentMethod      String?
  cancelledBy        String?
  cancellationReason String?
  cancelledAt        DateTime?
  lastBillingAt      DateTime?
  nextBillingAt      DateTime?
  currentPeriodStart DateTime?
  currentPeriodEnd   DateTime?
  metadata           Json      @default("{}")
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  @@index([userId])
  @@index([status])
  @@map("subscriptions")
}

// ==================== Discount Model ====================
model Discount {
  id                 String   @id @default(cuid())
  productId          String
  product            Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  name               String
  code               String?
  description        String?
  type               String
  value              Float
  minQuantity        Int      @default(0)
  maxQuantity        Int      @default(0)
  minimumOrderAmount Float    @default(0)
  usageLimitPerUser  Int      @default(0)
  startDate          DateTime
  endDate            DateTime
  isActive           Boolean  @default(true)
  stackable          Boolean  @default(false)
  priority           Int      @default(0)
  maxUsage           Int      @default(0)
  usedCount          Int      @default(0)
  metadata           Json     @default("{}")
  createdById        String?
  createdBy          User?    @relation("DiscountCreator", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@index([productId])
  @@index([startDate, endDate])
  @@map("discounts")
}

// ==================== Conversation Model ====================
model Conversation {
  id                  String                    @id @default(cuid())
  title               String?
  type                String                    @default("direct")
  lastMessageAt       DateTime?
  lastMessageContent  String?
  lastMessageSenderId String?
  isArchived          Boolean                   @default(false)
  isMuted             Boolean                   @default(false)
  participantCount    Int                       @default(0)
  metadata            Json                      @default("{}")
  participants        ConversationParticipant[]
  messages            Message[]
  createdAt           DateTime                  @default(now())
  updatedAt           DateTime                  @updatedAt

  @@map("conversations")
}

// ==================== ConversationParticipant Model ====================
model ConversationParticipant {
  id                   String       @id @default(cuid())
  conversationId       String
  conversation         Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  userId               String
  user                 User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  nickname             String?
  role                 String       @default("member")
  isMuted              Boolean      @default(false)
  notificationsEnabled Boolean      @default(true)
  pinnedAt             DateTime?
  lastReadAt           DateTime?
  joinedAt             DateTime     @default(now())

  @@unique([conversationId, userId])
  @@map("conversation_participants")
}

// ==================== Message Model ====================
model Message {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  senderId       String
  sender         User         @relation(fields: [senderId], references: [id], onDelete: Cascade)
  content        String
  type           String       @default("text")
  parentId       String?
  parent         Message?     @relation("MessageReplies", fields: [parentId], references: [id], onDelete: SetNull)
  replies        Message[]    @relation("MessageReplies")
  isRead         Boolean      @default(false)
  readAt         DateTime?
  deliveredAt    DateTime?
  editedAt       DateTime?
  attachments    Json         @default("[]")
  reactions      Json         @default("{}")
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([conversationId])
  @@index([senderId])
  @@index([parentId])
  @@map("messages")
}

// ==================== Invoice Model ====================
model Invoice {
  id              String    @id @default(cuid())
  orderId         String    @unique
  order           Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  invoiceNumber   String    @unique
  amount          Float
  subtotal        Float     @default(0)
  taxAmount       Float     @default(0)
  discountAmount  Float     @default(0)
  totalAmount     Float     @default(0)
  currency        String    @default("USD")
  status          String    @default("DRAFT")
  notes           String?
  billingAddress  String?
  shippingAddress String?
  pdfUrl          String?
  items           Json      @default("[]")
  issuedAt        DateTime  @default(now())
  dueDate         DateTime
  paidAt          DateTime?
  sentAt          DateTime?
  reminderSentAt  DateTime?
  cancelledAt     DateTime?
  cancelReason    String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([orderId])
  @@index([status])
  @@map("invoices")
}

// ==================== ReturnRequest Model ====================
model ReturnRequest {
  id                String    @id @default(cuid())
  orderItemId       String
  orderItem         OrderItem @relation(fields: [orderItemId], references: [id], onDelete: Cascade)
  userId            String
  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  reason            String
  reasonDescription String?
  resolution        String?
  refundAmount      Float     @default(0)
  returnLabelUrl    String?
  condition         String?
  status            String    @default("PENDING")
  quantity          Int       @default(1)
  images            Json      @default("[]")
  requestedAt       DateTime  @default(now())
  pickedUpAt        DateTime?
  deliveredBackAt   DateTime?
  inspectedAt       DateTime?
  resolvedAt        DateTime?

  @@index([orderItemId])
  @@index([userId])
  @@index([status])
  @@map("return_requests")
}

// ==================== SupportTicket Model ====================
model SupportTicket {
  id String @id @default(cuid())

  userId String
  user   User   @relation("CreatedTickets", fields: [userId], references: [id])

  assignedToId String?
  assignedTo   User?   @relation("AssignedTickets", fields: [assignedToId], references: [id])

  escalatedToId String?
  escalatedTo   User?   @relation("EscalatedTickets", fields: [escalatedToId], references: [id])

  relatedOrderId  String?
  relatedTicketId String?
  relatedTicket   SupportTicket?  @relation("RelatedTickets", fields: [relatedTicketId], references: [id], onDelete: SetNull)
  relatedTickets  SupportTicket[] @relation("RelatedTickets")

  subject     String
  description String

  status   String @default("OPEN")
  priority String @default("MEDIUM")
  category String @default("general")
  language String @default("en")

  resolution         String?
  escalationReason   String?
  satisfactionRating Int?
  feedback           String?
  tags               Json    @default("[]")

  resolvedAt DateTime?
  closedAt   DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  replies TicketReply[]

  @@index([userId])
  @@index([assignedToId])
  @@index([escalatedToId])
  @@index([status])
  @@index([priority])
  @@map("support_tickets")
}

// ==================== TicketReply Model ====================
model TicketReply {
  id          String        @id @default(cuid())
  ticketId    String
  ticket      SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  userId      String
  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  content     String
  isStaff     Boolean       @default(false)
  isInternal  Boolean       @default(false)
  isSolution  Boolean       @default(false)
  attachments Json          @default("[]")
  editedAt    DateTime?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([ticketId])
  @@index([userId])
  @@map("ticket_replies")
}

// ==================== Novu Workflow Metadata ====================
model NovuWorkflow {
  id          String   @id @default(cuid())
  workflowId  String   @unique
  name        String
  description String?
  status      String   @default("DRAFT")
  tags        String[]
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("novu_workflows")
}

// ==================== Novu Variable Groups ====================
model NovuVariableGroup {
  id          String         @id @default(cuid())
  name        String
  description String?
  sortOrder   Int            @default(0)
  variables   NovuVariable[]
  createdAt   DateTime       @default(now())

  @@map("novu_variable_groups")
}

// ==================== Novu Variable Registry ====================
model NovuVariable {
  id              String            @id @default(cuid())
  groupId         String
  group           NovuVariableGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  key             String
  type            String            @default("STRING")
  label           String?
  description     String?
  exampleValue    String?
  required        Boolean           @default(false)
  defaultValue    String?
  validationRules Json?
  aliases         String[]
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  @@unique([groupId, key])
  @@map("novu_variables")
}

model WeatherSnapshot {
  id          String   @id @default(cuid())
  latitude    Float
  longitude   Float
  temperature Float
  humidity    Int
  weatherCode Int
  severity    String
  recordedAt  DateTime @default(now())

  @@index([recordedAt])
}
